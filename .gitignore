# Build artifacts
*.obj
*.o
*.lib
*.exp
*.pdb
*.ilk
*.exe
*.so
*.a
.sconsign*
__pycache__/
*.pyc
*.jvn~
.vs/

# Local scratch and logs
scratch/
logs/
*.log
.cache/
dist/
build_nuitka/
.superpowers/

# Allow precompiled vendor libraries in modules and deps
!modules/**/lib/**/*.lib
!deps/**/*.lib
!deps/**/*.a
!deps/**/*.so
!services/bin/*.exe
!services/bin/*.dll
!tools/scada_tunnel/*.exe
# Ignore generated Nuitka binaries from git tracking (packaged into dist/ releases)
services/bin/dev_server.exe
services/bin/run_mindscada_svc.exe
services/bin/scada_stream_gateway.exe
services/bin/scada_ws_gateway.exe

# Secrets and tokens
.gitee_token
*.token
.env
.env.*


