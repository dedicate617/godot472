# Build artifacts
*.obj
*.o
*.lib
*.exp
*.pdb
*.ilk
*.exe
*.so
*.a
.sconsign*
__pycache__/
*.pyc
*.jvn~
.vs/

# Local scratch and logs
scratch/
logs/
*.log
.cache/
dist/
.superpowers/

# Allow precompiled vendor libraries in modules and deps
!modules/**/lib/**/*.lib
!deps/**/*.lib
!deps/**/*.a
!deps/**/*.so
!services/bin/*.exe
!services/bin/*.dll
!tools/scada_tunnel/*.exe

# Secrets and tokens
.gitee_token
*.token
.env
.env.*


